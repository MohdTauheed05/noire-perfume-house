# ---- Required ----
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-characters"
SITE_URL="http://localhost:3000"            # on Vercel: https://your-domain.com

# Firebase Admin (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Keep the quotes and the \n sequences exactly as they appear in the downloaded JSON file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Optional ----
# Needed only for uploading photos from /admin (Firebase console > Storage). Looks like your-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=""
# Alternative to the three FIREBASE_* variables above: the whole service-account JSON (raw or base64)
# FIREBASE_SERVICE_ACCOUNT_JSON=""
COOKIE_SECURE="true"   # set "false" ONLY for local http testing
