rules_version = '2';
// All data access goes through the Next.js server using the Firebase Admin SDK, which bypasses these rules.
// So browsers/mobile clients are denied everything: nobody can read users, orders or password hashes with your public project id.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
